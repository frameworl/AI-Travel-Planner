# Frontend .env example for AI Itinerary Planner (Vite)

# --- OpenAI (可选) ---
# 直连仅用于原型演示，生产环境建议通过后端代理转发
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-4o-mini

# --- Alibaba Cloud Bailian / DashScope（推荐国内使用） ---
# 在“阿里云控制台 > 百炼（DashScope）> API Key”创建密钥，格式通常为 sk-xxxx
VITE_DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 可选：模型名称，示例 qwen2.5（也可填写您在控制台可用的其他模型）
VITE_DASHSCOPE_MODEL=qwen2.5

# 选择使用的 LLM 提供商：openai | dashscope
# 若未设置，将按是否存在密钥自动推断；没有任何密钥时使用本地模拟
VITE_LLM_PROVIDER=dashscope

# 注意：
# 1) 切勿将真实密钥提交到版本库，.env 已默认加入 .gitignore
# 2) 修改 .env 后需重启开发服务器

# --- 高德地图 Web JS API ---
# 在高德开放平台创建应用，添加 Web 端 JS API Key，域名白名单需包含 localhost 及生产域名
VITE_AMAP_KEY=
# 可选：若开启了安全策略，请填写安全码（需先在高德控制台启用）
VITE_AMAP_SECURITY_JS_CODE=

# --- 讯飞语音听写（ASR，WebSocket） ---
# 在讯飞开放平台创建应用，并在“语音听写（流式版）”服务中获取以下信息
VITE_ASR_PROVIDER=xfyun
VITE_XFYUN_APP_ID=
VITE_XFYUN_API_KEY=
VITE_XFYUN_API_SECRET=
# 提示：前端直连仅用于开发/演示，生产需后端签名代理，避免泄露密钥